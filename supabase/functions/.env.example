# Copia a supabase/functions/.env para `supabase functions serve` en local.
# En producción: supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY ya los pone Supabase automáticamente.)
SITE_URL=https://entradas.tudominio.com
RESEND_API_KEY=re_...
EMAIL_FROM="Entradas Mi Sala <entradas@tudominio.com>"
EMAIL_REPLY_TO=hola@tudominio.com
ORGANIZER_NAME="Mi Sala S.L."

# Datos que ve el comprador para pagar
BIZUM_PHONE="600 000 000"
BANK_IBAN="ES00 0000 0000 0000 0000 0000"
BANK_HOLDER="Mi Sala S.L."
# Horas que se guarda la plaza mientras llega el pago
RESERVATION_HOURS=72

EVENT_TIMEZONE=Europe/Madrid
RETENTION_DAYS=30
CONSENT_VERSION=2026-09
