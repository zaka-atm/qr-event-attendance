    "test:demo": "node tests/e2e/demo.test.cjs",
    "test:recepcio": "node tests/recepcio/backend.test.cjs && node tests/recepcio/app.test.cjs"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
